# Copy to .env next to docker-compose.yml and adjust. .env is not committed.

# Name users type in their browser (needs a DNS record pointing at this server).
# No domain? <ip-with-dashes>.sslip.io resolves to the IP, e.g. 157-151-163-88.sslip.io.
# Used by the https profile only.
STUDIO_DOMAIN=studio.example.com

# HTTPS port. Keep 443 unless another app on the server already uses it (then e.g. 8443,
# and allow that port in the cloud firewall). Port 80 must stay reachable for the certificate.
STUDIO_HTTPS_PORT=443

# Where the studio itself listens on the server. Keep 127.0.0.1 when Caddy serves it.
# Without Caddy (plain HTTP on the network, not recommended): 0.0.0.0:8010, and set
# STUDIO_TRUSTED_PROXIES=127.0.0.1 so nobody can fake their IP in the audit log.
STUDIO_PUBLISH=127.0.0.1:8010

# Time zone of dashboard times and {now} in test data. A POSIX offset needs no zone data:
# IST-05:30 is India (UTC+05:30), CET-01:00 is Central Europe in winter.
TZ=UTC

# Labels the server in exported issue logs.
STUDIO_DEVICE_NAME=studio-server

# How long a sign-in lasts, in hours.
STUDIO_SESSION_HOURS=12

# Optional. Signs the sign-in cookie; when empty one is generated into data/secret_key.
# Changing it signs everybody out.
STUDIO_SECRET_KEY=

# Slow test instances: multiply every replay wait by this.
STUDIO_SLOW_FACTOR=1

# Users record and run at the same time. Live screens: how many browsers can be shown at
# once (sign-ins, recordings, and runs with "Show browser" ticked). Max sessions: how many
# browsers at once in all, shown or hidden. Each takes ~0.5 GB of RAM on the server.
STUDIO_SCREENS=4
STUDIO_MAX_SESSIONS=6
